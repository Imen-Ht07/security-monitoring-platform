# Development Environment Variables
# Copy this file to .env and update the values for your local development setup

# Application Settings
NODE_ENV=development
PORT=3000
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/security_monitoring_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=security_monitoring_dev

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d
API_KEY=your_api_key_here
ENCRYPTION_KEY=your_encryption_key_here

# External Services & APIs
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@security-monitoring.local

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security Monitoring
ALERT_EMAIL=admin@security-monitoring.local
SLACK_WEBHOOK_URL=
SENTRY_DSN=

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30000

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/uploads


# Feature Flags
ENABLE_2FA=true
ENABLE_AUDIT_LOG=true
ENABLE_NOTIFICATIONS=true

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_ENV=development
